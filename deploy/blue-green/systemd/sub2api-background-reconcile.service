[Unit]
Description=Revalidate Sub2API background ownership after completed host release
After=docker.service nginx.service network-online.target
Wants=network-online.target
Requires=docker.service nginx.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/sub2api2/blue-green/scripts/background-reconcile.py --config /opt/sub2api2/blue-green/private/config.json --token-pair /opt/sub2api2/blue-green/private/token-pair.json reconcile
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true

# Enable the timer, not this oneshot directly. It never starts a container,
# switches Nginx, drains/cancels HTTP, or resumes a migration.
