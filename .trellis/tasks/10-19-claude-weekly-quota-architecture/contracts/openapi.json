  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "MoneyInput": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,8})?$",
        "not": {
          "pattern": "^0(\\.0+)?$"
        },
        "maxLength": 21,
        "description": "十进制字符串；服务端另外校验大于零；拒绝科学计数和多余小数位。"
      },
      "Money": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,11})\\.[0-9]{8}$"
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "message": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "metadata": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        },
        "required": [
          "code",
          "message",
          "reason"
        ]
      },
      "Term": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "group_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "subscription_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "term_no": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quota_usd": {
            "$ref": "#/components/schemas/Money"
          },
          "used_usd": {
            "$ref": "#/components/schemas/Money"
          },
          "pending_usd": {
            "$ref": "#/components/schemas/Money"
          },
          "remaining_usd": {
            "$ref": "#/components/schemas/Money"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "active",
              "exhausted",
              "expired",
              "cancelled",
              "reconciling"
            ]
          },
          "lifecycle_state": {
            "type": "string",
            "enum": [
              "scheduled",
              "active",
              "closing",
              "closed"
            ]
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "cancelled_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "unsettled_request_count": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "group_id",
          "subscription_id",
          "term_no",
          "quota_usd",
          "used_usd",
          "pending_usd",
          "remaining_usd",
          "status",
          "lifecycle_state",
          "starts_at",
          "expires_at",
          "cancelled_at",
          "revision",
          "unsettled_request_count"
        ]
      },
      "Summary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "quota_mode": {
            "const": "term"
          },
          "revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          },
          "current_term": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Term"
              },
              {
                "type": "null"
              }
            ]
          },
          "last_term": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Term"
              },
              {
                "type": "null"
              }
            ]
          },
          "next_terms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Term"
            }
          }
        },
        "required": [
          "group_id",
          "quota_mode",
          "revision",
          "server_time",
          "current_term",
          "last_term",
          "next_terms"
        ]
      },
      "OpenTermInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "operation": {
            "type": "string",
            "enum": [
              "open",
              "renew"
            ]
          },
          "quota_usd": {
            "$ref": "#/components/schemas/MoneyInput"
          },
          "plan_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "expected_revision": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "group_id",
          "operation",
          "expected_revision"
        ],
        "anyOf": [
          {
            "required": [
              "quota_usd"
            ]
          },
          {
            "required": [
              "plan_id"
            ]
          }
        ]
      },
      "PreviewInput": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "group_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "operation": {
            "type": "string",
            "enum": [
              "open",
              "renew"
            ]
          },
          "quota_usd": {
            "$ref": "#/components/schemas/MoneyInput"
          },
          "plan_id": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "notes": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "group_id",
          "operation"
        ],
        "anyOf": [
          {
            "required": [
              "quota_usd"
            ]
          },
          {
            "required": [
              "plan_id"
            ]
          }
        ]
      },
      "Preview": {
        "type": "object",
